{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "docker: build and run unoserver-docker",
      "type": "shell",
      "command": "set -e; overlay=''; if [ '${input:localAppArmorProfile}' = 'enabled' ]; then overlay='-f docker-compose.apparmor.yml'; fi; docker build -f \"${workspaceFolder}/Dockerfile.custom\" -t unoserver-docker:local .; docker compose -p ragtime-unoserver -f docker-compose.latest.yml $overlay up -d; docker network inspect -f '{{.Name}} internal={{.Internal}}' unoserver-docker-net; docker inspect -f '{{.Name}} apparmor={{.AppArmorProfile}}' unoserver-docker",
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "IMAGE_REF": "unoserver-docker:local"
        }
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": []
    },
    {
      "label": "docker: stop and remove unoserver-docker",
      "type": "shell",
      "command": "docker compose -p ragtime-unoserver -f docker-compose.latest.yml -f docker-compose.host-port.yml down --remove-orphans",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": false
      },
      "problemMatcher": []
    },
    {
      "label": "local: run unoserver-docker",
      "type": "shell",
      "command": "docker build -f \"${workspaceFolder}/Dockerfile.custom\" -t unoserver-docker:local . && \"${workspaceFolder}/scripts/unoserver/run-local.sh\"",
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "CPU_LIMIT": "2",
          "MEMORY_LIMIT": "1g",
          "PIDS_LIMIT": "128",
          "APPARMOR_PROFILE": "${input:localAppArmorProfile}"
        }
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": false
      },
      "problemMatcher": []
    },
    {
      "label": "local: stop unoserver-docker",
      "type": "shell",
      "command": "${workspaceFolder}/scripts/unoserver/stop-local.sh",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": false
      },
      "problemMatcher": []
    },
    {
      "label": "local: spawn a shell",
      "type": "shell",
      "command": "${workspaceFolder}/scripts/unoserver/spawn-shell.sh",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": false
      },
      "problemMatcher": []
    },
    {
      "label": "audit: scan unoserver-docker (trivy)",
      "type": "shell",
      "command": "${workspaceFolder}/scripts/trivy/scan-image.sh",
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "REPO_TARGET": "${workspaceFolder}",
          "DOCKERFILE_PATH": "${workspaceFolder}/Dockerfile.custom",
          "IMAGE_LABEL_SELECTOR": "org.opencontainers.image.title=unoserver-docker",
          "IMAGE_FILTER": "*unoserver-docker*",
          "SEVERITY": "UNKNOWN,LOW,MEDIUM,HIGH,CRITICAL",
          "FAIL_SEVERITY": "HIGH,CRITICAL",
          "TRIVY_CLEAN_ARGS": "--scan-cache"
        }
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": false
      },
      "problemMatcher": []
    },
    {
      "label": "test: office fixtures to pdf",
      "type": "shell",
      "command": "${workspaceFolder}/tests/test-office-fixtures-to-pdf.sh",
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "API_PROTOCOL": "http",
          "ENDPOINT_HOST": "127.0.0.1",
          "ENDPOINT_PORT": "2003"
        }
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": false
      },
      "problemMatcher": []
    },
    {
      "label": "audit: scan docker bench security (full host)",
      "type": "shell",
      "command": "${workspaceFolder}/scripts/docker-bench/run.sh",
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "DOCKER_BENCH_ARGS": "-t org.opencontainers.image.title=unoserver-docker -i unoserver-docker"
        }
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": false
      },
      "problemMatcher": []
    },
    {
      "label": "audit: scan docker bench security (containers only)",
      "type": "shell",
      "command": "${workspaceFolder}/scripts/docker-bench/run.sh",
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "DOCKER_BENCH_ARGS": "-c container_runtime,container_images -t org.opencontainers.image.title=unoserver-docker -i unoserver-docker"
        }
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": false
      },
      "problemMatcher": []
    }
  ],
  "inputs": [
    {
      "id": "localAppArmorProfile",
      "type": "pickString",
      "description": "Use the AppArmor profile for local unoserver-docker?",
      "options": [
        "enabled",
        "disabled"
      ],
      "default": "enabled"
    }
  ]
}
