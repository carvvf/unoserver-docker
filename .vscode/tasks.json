{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build unoserver-docker",
      "type": "shell",
      "command": "docker",
      "args": [
        "build",
        "-t",
        "unoserver-docker:local",
        "."
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": []
    },
    {
      "label": "run unoserver-docker",
      "type": "shell",
      "dependsOn": "build unoserver-docker",
      "command": "docker",
      "args": [
        "run",
        "--rm",
        "-p",
        "2003:2003",
        "unoserver-docker:local"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": false
      },
      "problemMatcher": []
    }
  ]
}
