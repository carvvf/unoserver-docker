{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build unoserver-docker",
      "type": "shell",
      "command": "docker",
      "args": [
        "build",
        "-f",
        "${workspaceFolder}/Dockerfile.custom",
        "-t",
        "unoserver-docker:local",
        "."
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": []
    },
    {
      "label": "local: run unoserver-docker",
      "type": "shell",
      "dependsOn": "build unoserver-docker",
      "command": "${workspaceFolder}/scripts/unoserver/run-local.sh",
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "CPU_LIMIT": "2",
          "MEMORY_LIMIT": "1g",
          "PIDS_LIMIT": "128"
        }
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": false
      },
      "problemMatcher": []
    },
    {
      "label": "local: stop unoserver-docker",
      "type": "shell",
      "command": "${workspaceFolder}/scripts/unoserver/stop-local.sh",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": false
      },
      "problemMatcher": []
    },
    {
      "label": "local: spawn a shell",
      "type": "shell",
      "command": "${workspaceFolder}/scripts/unoserver/spawn-shell.sh",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": false
      },
      "problemMatcher": []
    },
    {
      "label": "audit: scan unoserver-docker (trivy)",
      "type": "shell",
      "command": "${workspaceFolder}/scripts/trivy/scan-image.sh",
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "REPO_TARGET": "${workspaceFolder}",
          "DOCKERFILE_PATH": "${workspaceFolder}/Dockerfile.custom",
          "IMAGE_LABEL_SELECTOR": "org.opencontainers.image.title=unoserver-docker",
          "IMAGE_FILTER": "*unoserver-docker*",
          "SEVERITY": "UNKNOWN,LOW,MEDIUM,HIGH,CRITICAL",
          "FAIL_SEVERITY": "HIGH,CRITICAL",
          "TRIVY_CLEAN_ARGS": "--scan-cache"
        }
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": false
      },
      "problemMatcher": []
    },
    {
      "label": "test: office fixtures to pdf",
      "type": "shell",
      "command": "${workspaceFolder}/tests/test-office-fixtures-to-pdf.sh",
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "API_PROTOCOL": "http",
          "ENDPOINT_HOST": "127.0.0.1",
          "ENDPOINT_PORT": "2003"
        }
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": false
      },
      "problemMatcher": []
    },
    {
      "label": "audit: scan docker bench security (full host)",
      "type": "shell",
      "command": "${workspaceFolder}/scripts/docker-bench/run.sh",
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "DOCKER_BENCH_ARGS": "-t org.opencontainers.image.title=unoserver-docker -i unoserver-docker"
        }
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": false
      },
      "problemMatcher": []
    },
    {
      "label": "audit: scan docker bench security (containers only)",
      "type": "shell",
      "command": "${workspaceFolder}/scripts/docker-bench/run.sh",
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "DOCKER_BENCH_ARGS": "-c container_runtime,container_images -t org.opencontainers.image.title=unoserver-docker -i unoserver-docker"
        }
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": false
      },
      "problemMatcher": []
    }
  ]
}
